{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nvidiaforjanitors",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "IMAGE_CACHE",
			"id": "<REPLACE_ME>",
		},
	],
}
